# WorkOS API key (WorkOS dashboard > API keys) — server-only, never expose to the client
WORKOS_API_KEY=sk_test_your-workos-api-key
# WorkOS client ID (WorkOS dashboard > API keys)
WORKOS_CLIENT_ID=client_your-workos-client-id
# Key the AuthKit session cookie is encrypted with — at least 32 characters (`openssl rand -base64 24`)
WORKOS_COOKIE_PASSWORD=your-cookie-password-of-32-chars-or-more
# AuthKit callback URL, must match the redirect URI registered in the WorkOS dashboard.
# Required at BUILD time, not just at runtime: Next inlines NEXT_PUBLIC_* into the bundle when
# `next build` runs, and it also supplies the origin the checkout returns customers to. Adding
# it to the deployment after a build leaves that build broken until it is rebuilt.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:4100/callback
# Optional, defaults to lax. LEAVE IT ALONE unless you have added CSRF tokens first:
# /api/checkout and /api/plan are cookie-authenticated form POSTs, so SameSite=lax on the
# session cookie is the only thing stopping a page on another origin from submitting them
# on a signed-in user's behalf. Setting this to "none" removes that defence entirely.
# WORKOS_COOKIE_SAMESITE=lax
# Supabase project URL (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
# Supabase service_role key (Project Settings > API) — bypasses RLS, server-only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Polar organization access token (Polar dashboard > Settings > Developers) — server-only
POLAR_ACCESS_TOKEN=your-polar-access-token
# Which Polar environment to talk to: sandbox or production. Anything else is read as sandbox.
POLAR_SERVER=sandbox
# Polar product ids — they differ between sandbox and production, so they are configuration
POLAR_PRODUCT_FREE=your-free-product-id
POLAR_PRODUCT_PRO=your-pro-product-id
POLAR_PRODUCT_MAX=your-max-product-id
POLAR_PRODUCT_ULTRA=your-ultra-product-id
# Serves the holding page instead of /, /billing and /usage while the agent is not available.
# Enabled ONLY by the value "1" or "true" (case- and whitespace-insensitive); unset, "", "0"
# and "false" are all off — spelled out because Vercel stores every variable as a string, so a
# naive truthiness check would let the literal "false" switch it on.
#
# Read per request in proxy.ts, never at build time, so setting or unsetting it in the Vercel
# dashboard takes effect without a redeploy. The same variable belongs on the projects for
# seriora.ai and seri-agent.seriora.ai, whose .env.example files are gitignored and so cannot
# document it. Delete it at launch by reverting the PR that added it — see
# packages/ui/src/holding-flag.ts.
# SERI_COMING_SOON=1
